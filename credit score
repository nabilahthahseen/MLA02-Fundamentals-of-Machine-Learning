from sklearn.tree import DecisionTreeClassifier

# Sample data: [Income, Loan Amount]
X = [[20000, 5000], [30000, 8000],
     [50000, 10000], [60000, 15000],
     [15000, 12000], [70000, 10000]]

# Credit score categories
y = ["Poor", "Poor", "Good", "Good", "Poor", "Good"]

# Train the model
model = DecisionTreeClassifier()
model.fit(X, y)

# Predict credit score category
income = int(input("Enter income: "))
loan = int(input("Enter loan amount: "))

result = model.predict([[income, loan]])

print("Credit Score Category:", result[0])
