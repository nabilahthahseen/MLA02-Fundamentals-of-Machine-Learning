from sklearn.neighbors import KNeighborsClassifier

# Training data
X = [[1, 2], [2, 3], [3, 4],
     [6, 7], [7, 8], [8, 9]]

# Class labels
y = [0, 0, 0, 1, 1, 1]

# Create K-NN model
model = KNeighborsClassifier(n_neighbors=3)

# Train the model
model.fit(X, y)

# Predict a new value
new_data = [[4, 5]]
result = model.predict(new_data)

print("Predicted class:", result[0])

