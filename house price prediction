from sklearn.linear_model import LinearRegression

# House data
X = [[1000], [1500], [2000], [2500], [3000]]
y = [2000000, 3000000, 4000000, 5000000, 6000000]

# Create and train the model
model = LinearRegression()
model.fit(X, y)

# Predict price for a 1800 sq.ft house
area = [[1800]]
price = model.predict(area)

print("House Area:", area[0][0], "sq.ft")
print("Predicted House Price: Rs.", round(price[0], 2))



House Area: 1800 sq.ft
Predicted House Price: Rs. 3600000.0
