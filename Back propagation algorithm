import numpy as np
from sklearn.neural_network import MLPClassifier

# Training dataset (XOR)
X = np.array([[0, 0],
              [0, 1],
              [1, 0],
              [1, 1]])

y = np.array([0, 1, 1, 0])

# Create Artificial Neural Network
ann = MLPClassifier(hidden_layer_sizes=(4,),
                    activation='logistic',
                    solver='lbfgs',
                    max_iter=5000,
                    random_state=1)

# Train the network using backpropagation
ann.fit(X, y)

# Test the network
predictions = ann.predict(X)

print("Input\tOutput")
for i in range(len(X)):
    print(X[i], "\t", predictions[i])




